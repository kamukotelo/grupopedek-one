# ==============================================================================
# PEPEK GRUPO — CONFIGURAÇÕES DE AMBIENTE (EXEMPLO)
# ==============================================================================

# Neon (navegador: Auth + Data API protegida por RLS)
VITE_NEON_AUTH_URL=https://your-auth-host.neonauth.example/database/auth
VITE_NEON_DATA_API_URL=https://your-data-host.apirest.example/database/rest/v1

# Neon (servidor apenas — nunca prefixar com VITE_)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEON_AUTH_JWKS_URL=https://your-auth-host.neonauth.example/database/auth/.well-known/jwks.json

# Modo de Operação ('false' = real, 'true' = demo)
VITE_DEMO_MODE=false

# URL Oficial do Site
SITE_URL=https://grupopedek-one.vercel.app

# Contatos
VITE_WHATSAPP_NUMBER=244923719090
VITE_CONTACT_EMAIL=geral@pepekgrupo.com

# ------------------------------------------------------------------------------
# 1. STRIPE (Cartão Internacional Visa / Mastercard)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 2. MULTICAIXA EXPRESS / EMIS (Angola · AOA)
# ------------------------------------------------------------------------------
EMIS_MERCHANT_ID=your_emis_merchant_id
EMIS_API_KEY=your_emis_api_key
EMIS_WEBHOOK_SECRET=your_emis_webhook_secret

# ------------------------------------------------------------------------------
# 3. MB WAY / SIBS (Portugal · EUR)
# ------------------------------------------------------------------------------
MBWAY_MERCHANT_ID=your_mbway_merchant_id
MBWAY_API_KEY=your_mbway_api_key
MBWAY_WEBHOOK_SECRET=your_mbway_webhook_secret

# ------------------------------------------------------------------------------
# 4. COORDENADAS BANCÁRIAS — PORTUGAL (EUR)
# ------------------------------------------------------------------------------
VITE_BANK_PT_NAME=Nome do Banco em Portugal
VITE_BANK_PT_BENEFICIARY=Nome do Titular da Conta
VITE_BANK_PT_IBAN=PT50000000000000000000000
VITE_BANK_PT_SWIFT=SWIFT_BIC

# ------------------------------------------------------------------------------
# 5. COORDENADAS BANCÁRIAS — ANGOLA (AOA)
